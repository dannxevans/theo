{
  "cpu": 0,
  "environment": [
    {
      "name": "PORT",
      "value": "1066"
    },
    {
      "name": "ENV",
      "value": "prod"
    },
    {
      "name": "THEO_S3_BACKUP_BUCKET",
      "value": "theo-database-backups"
    },
    {
      "name": "THEO_S3_BACKUP_KEY",
      "value": "theo/theo.db"
    }
  ],
  "environmentFiles": [],
  "essential": true,
  "image": "ghcr.io/dannxevans/theo-backend:latest",
  "logConfiguration": {
    "logDriver": "awslogs",
    "options": {
      "awslogs-group": "/ecs/theo-backend",
      "awslogs-create-group": "true",
      "awslogs-region": "eu-west-2",
      "awslogs-stream-prefix": "ecs"
    },
    "secretOptions": []
  },
  "mountPoints": [
    {
      "containerPath": "/app/backend/data",
      "readOnly": false,
      "sourceVolume": "theo-data"
    }
  ],
  "name": "backend",
  "portMappings": [
    {
      "appProtocol": "http",
      "containerPort": 1066,
      "hostPort": 1066,
      "name": "backend-1066-tcp",
      "protocol": "tcp"
    }
  ],
  "systemControls": [],
  "ulimits": [],
  "volumesFrom": []
}
